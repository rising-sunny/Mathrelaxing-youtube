[Unit]
Description=Private eBay seller API gateway for MathRelaxing bridge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mathrelaxing-ebay-api
Group=mathrelaxing-bridge
ExecStart=/usr/bin/python3 /opt/mathrelaxing-bridge/ebay_gateway.py
WorkingDirectory=/opt/mathrelaxing-bridge
LoadCredential=ebay.json:/etc/mathrelaxing-ebay-api/ebay.json
RuntimeDirectory=mathrelaxing-ebay-api
RuntimeDirectoryMode=0750
StateDirectory=mathrelaxing-ebay-api
StateDirectoryMode=0700
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=-/opt/etsy-lulu -/opt/etsy_lulu_fulfill

[Install]
WantedBy=multi-user.target
