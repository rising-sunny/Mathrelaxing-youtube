# Render output
output/

# Blender portable + temp
tools/blender*/
tools/*.zip
*.blend1
*.blend2
*.blend@

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# Credenciales / tokens (nunca deben ir al repo)
token*.json
token*.pickle
client_secret*.json
*.env
*CREDENCIALES*

# Caches de simulacion (regenerables, ~160 MB) — no versionar
*.npz

# Eventos de renders de prueba: output/ ya esta ignorado, pero las escenas
# tambien escriben data/<name>_events.json. Los nombres con _ al principio
# son borradores (--name _algo) y no van al repo.
data/_*_events.json

# Pistas licenciadas (Epidemic Sound): se resuelven por tools/music_library.py
assets/music/*
!assets/music/README.md

# Cumulos DLA cacheados: se regeneran con la escena (minutos, no horas)
output/**/cluster.npy

# conectoma MaleCNS (FlyEM, CC-BY): ~560 MB, se descarga solo desde el bucket publico
data/malecns/
